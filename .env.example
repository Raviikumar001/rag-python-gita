# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Application Settings
APP_ENV=development
DEBUG=True
PORT=8080
HOST=0.0.0.0

# Security — SHA-256 hash of your API key (not the key itself)
# Generate: python3 -c "import hashlib; print(hashlib.sha256(b'my-secret-key'.encode()).hexdigest())"
# Clients send the plain key: Authorization: Bearer my-secret-key
API_KEY=

# Embedding Model Configuration
# gemini-embedding-2-preview = 3072 dims, text-embedding-004 = 768 dims
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_VECTOR_SIZE=3072
GEMINI_MODEL=gemini-3-flash-preview

# Cache (leave empty for in-memory cache)
REDIS_URL=
CACHE_TTL=3600

# Vector Database
QDRANT_PATH=data/qdrant_storage
QDRANT_COLLECTION=gita

# HuggingFace Token (optional, for model downloads)
HF_TOKEN=

# Reranker - disabled by default to save ~400MB memory
ENABLE_RERANKER=false
RERANKER_MODEL=BAAI/bge-reranker-base

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Search
SEARCH_TOP_K=10
RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.3

# Rate Limiting
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Langfuse Observability (optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Processing
MAX_TOKENS=8192
